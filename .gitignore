# ---------------------------------------------------------------------------
# Globe v1 Phase G1.
#
# `frontend/tests/unit` and `frontend/tests/e2e` immediately above exclude the
# DIRECTORIES themselves, and git never descends into an excluded directory --
# so a bare `!<dir>/<file>` cannot re-include anything under one, and the
# allowlist near the top of this file is dead for any NEW file. Re-open each
# directory, re-exclude its contents (preserving the original intent), then
# allowlist what Phase G1 adds.
# ---------------------------------------------------------------------------
# Scoped to this phase's file rather than `**`: another session has untracked
# work in this directory that is not Phase G1's to add.
!frontend/tests/unit/
frontend/tests/unit/*
!frontend/tests/unit/globe-mesh.test.ts
# Phase G2 (the user-facing globe layer). Same scoping rule as G1 above:
# named files only, never `**`.
!frontend/tests/unit/globe-projection-g2.test.ts
!frontend/tests/unit/globe-share-compose.test.ts
!frontend/tests/unit/permalink-projection.test.ts
# Globe v1.1 (hover intent + space background). Named files only, as above.
!frontend/tests/unit/hover-intent.test.ts
# SST coastline clip: land-mask layer contract (degradation + ordering).
!frontend/tests/unit/land-mask-layer.test.ts
# Niño 3.4 reference box (SST-only static overlay).
!frontend/tests/unit/nino-region-layer.test.ts
# City label mode resolution (sst = no city labels at all).
!frontend/tests/unit/city-label-mode.test.ts

!frontend/tests/e2e/
frontend/tests/e2e/*
!frontend/tests/e2e/render-golden-harness.ts
!frontend/tests/e2e/render-golden-globe.spec.ts
!frontend/tests/e2e/globe-view.spec.ts
!frontend/tests/e2e/hover-intent.spec.ts
!frontend/tests/e2e/new-feature-badges.spec.ts
# Globe limb fringe fix: the DPR-2 limb-coverage gate.
!frontend/tests/e2e/globe-limb-coverage.spec.ts
# Globe H/L pressure-centre cull (the overlay the G2 audit missed).
!frontend/tests/e2e/globe-pressure-centers.spec.ts
# H/L markers composited into canvas captures (screenshot share paths).
!frontend/tests/e2e/pressure-centers-capture.spec.ts
# Named files only, same rule as the entries above: the 13 mercator PNGs in
# the baseline snapshot directory are already tracked and are not this phase's
# to (re)stage, so only the globe goldens G1/G2 added are re-included.
!frontend/tests/e2e/render-golden-baseline.spec.ts-snapshots/
!frontend/tests/e2e/render-golden-baseline.spec.ts-snapshots/globe-4326-world-live-canvas.png
!frontend/tests/e2e/render-golden-baseline.spec.ts-snapshots/globe-4326-seam-live-canvas.png
!frontend/tests/e2e/render-golden-baseline.spec.ts-snapshots/globe-4326-pole-live-canvas.png
!frontend/tests/e2e/render-golden-baseline.spec.ts-snapshots/globe-3857-regional-live-canvas.png

!frontend/tests/e2e/render-golden-globe.spec.ts-snapshots/
frontend/tests/e2e/render-golden-globe.spec.ts-snapshots/*
!frontend/tests/e2e/render-golden-globe.spec.ts-snapshots/globe-4326-world-map-canvas-chromium-darwin.png
!frontend/tests/e2e/render-golden-globe.spec.ts-snapshots/globe-4326-seam-map-canvas-chromium-darwin.png
!frontend/tests/e2e/render-golden-globe.spec.ts-snapshots/globe-4326-pole-map-canvas-chromium-darwin.png
