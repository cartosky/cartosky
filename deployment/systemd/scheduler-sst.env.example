# CartoSky SST poller configuration
# Copy to: /etc/cartosky/scheduler-sst.env
CARTOSKY_SST_DATA_ROOT=/opt/cartosky/data
# Upstream publishes one frame per day; hourly polling is enough to pick it up
# promptly. Floor is 300s.
CARTOSKY_SST_POLL_SECONDS=3600
# Runs to retain per domain (staging/published/manifests). One run per day.
CARTOSKY_SST_KEEP_RUNS=6
# Read timeout for an ERDDAP griddap subset (~100-200 MB, built server-side).
CARTOSKY_SST_TIMEOUT_SECONDS=600
# Daily frames per published bundle (fh000 oldest -> fhNNN newest). Also bounds
# the first-ever backfill and any per-cycle catch-up.
CARTOSKY_SST_BUNDLE_FRAMES=14
